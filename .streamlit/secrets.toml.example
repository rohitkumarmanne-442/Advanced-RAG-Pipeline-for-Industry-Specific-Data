# Copy this file to `.streamlit/secrets.toml` for local dev, and mirror the
# same keys in the Streamlit Cloud secrets UI for production.
#
# NONE of these values should ever be committed to source control.

# Existing app secret
GROQ_API_KEY = ""

# ─── Contact form ────────────────────────────────────────────────────────────
# The app will try transports in this order and fall back to logging the
# submission if none are configured (the user still sees a success banner).

# Option A — Formspree (or any form-backend that accepts urlencoded POSTs)
# CONTACT_FORMSPREE_URL = "https://formspree.io/f/your-form-id"

# Option B — SMTP relay (Gmail app password, SendGrid, Mailgun, etc.)
# CONTACT_EMAIL   = "you@example.com"   # Inbox that receives messages
# SMTP_HOST       = "smtp.gmail.com"
# SMTP_PORT       = "465"                # 465 = SSL, 587 = STARTTLS
# SMTP_USER       = "you@example.com"
# SMTP_PASSWORD   = "your-app-password"
