# Streamlit secrets template — copy to `.streamlit/secrets.toml` for local dev
# and mirror the same keys in Streamlit Cloud → App settings → Secrets.
#
# NEVER commit the populated file. Only this `.example` should live in git.

# ── Existing LLM secret (already used by the app) ─────────────────────────────
# GROQ_API_KEY = "gsk_..."
# STREAMLIT_CLOUD = "true"

# ── Contact form: Option A — Formspree (recommended for cloud) ────────────────
# Sign up at https://formspree.io, create a form, paste its endpoint here.
# When set, the app POSTs {name,email,message} as JSON to this URL.
# FORMSPREE_ENDPOINT = "https://formspree.io/f/xxxxxxx"

# ── Contact form: Option B — SMTP relay (self-hosted / Gmail / Mailgun) ───────
# All four SMTP_* keys + CONTACT_EMAIL must be set for SMTP delivery.
# CONTACT_EMAIL  = "you@example.com"        # inbox that receives messages
# SMTP_HOST      = "smtp.gmail.com"
# SMTP_PORT      = "587"                     # STARTTLS; use 465 for implicit TLS
# SMTP_USER      = "you@example.com"
# SMTP_PASSWORD  = "app-password-not-your-login-password"
# SMTP_FROM      = "you@example.com"        # optional; defaults to SMTP_USER

# ── Fallback ──────────────────────────────────────────────────────────────────
# If neither Formspree nor SMTP secrets are configured, the app logs the
# submission via the stdlib logger and still shows a success confirmation
# to the user (cloud-safe fallback).
